# Copy to .env and adjust. Never commit the real .env file.
# With DJANGO_DEBUG=False the site refuses to start while a secret still contains "change-me"
# (generate one: python -c "import secrets; print(secrets.token_urlsafe(50))").
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# When DEBUG=False: HTTPS redirect + Secure cookies + HSTS are on by default.
# For a local DEBUG=False run over plain HTTP set both to False.
# DJANGO_SSL_REDIRECT=True
# DJANGO_HTTPS=True
# For production behind HTTPS, e.g. https://levelupgear.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000
# Behind a reverse proxy: trust the last N X-Forwarded-For hops, and/or a header the proxy always sets.
# Leave both empty when the app is reached directly (otherwise visitors could forge their IP).
# TRUSTED_PROXY_COUNT=1
# CLIENT_IP_HEADER=CF-Connecting-IP

# Database: empty = SQLite (db.sqlite3). Postgres example:
# DATABASE_URL=postgres://levelup:levelup@db:5432/levelup
DATABASE_URL=

# Payments: "mock" = built-in simulated gateway (no keys needed), "vnpay" = VNPay sandbox
PAYMENT_MODE=mock
# Simulated gateway (VNPay without keys, MoMo): defaults to on only when DJANGO_DEBUG=True.
# It marks orders paid with no real money — keep it off on any public shop.
# ALLOW_MOCK_PAYMENTS=False
# Required (≥32 random chars) if ALLOW_MOCK_PAYMENTS is on with DJANGO_DEBUG=False
MOCK_GATEWAY_SECRET=change-me
# Register a free sandbox merchant at https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Unpaid VNPay/MoMo orders are cancelled after N minutes (manage.py expire_unpaid_orders)
UNPAID_ORDER_TIMEOUT_MINUTES=60

# Bank transfer receiving account — encoded as a NAPAS VietQR code (BIN 970436 = Vietcombank)
BANK_NAME=Vietcombank
BANK_BIN=970436
BANK_ACCOUNT_NO=0001234567890
BANK_ACCOUNT_NAME=CONG TY TNHH LEVELUP GEAR VIET NAM

# Optional: LLM fallback for the chatbot (Google Gemini). Leave empty to run fully offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# E-mail (console backend prints e-mails to the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Staff account "admin" created by seed_demo. Required when DJANGO_DEBUG=False
# (without it the account is created with login disabled); in DEBUG the README demo password is used.
DJANGO_SUPERUSER_PASSWORD=

# Path of the Django admin (default: derived from DJANGO_SECRET_KEY, printed by `manage.py seed_demo`).
# DJANGO_ADMIN_URL=
# "database" stores uploaded images in the database (hosts whose disk is wiped on deploy); default "filesystem".
# MEDIA_STORAGE=filesystem
